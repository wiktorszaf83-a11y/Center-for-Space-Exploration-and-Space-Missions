# === Node.js / npm ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Plik lock jest śledzony (package-lock.json) – zapewnia powtarzalne instalacje.

# === Zmienne środowiskowe / sekrety ===
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# === Pliki generowane w czasie działania aplikacji ===
# Raporty tworzone dynamicznie przez controllers/reportsController.js
data/missions-report.csv
data/planets-report.txt

# Pliki przesyłane przez użytkowników (controllers/uploadController.js)
public/uploads/*
!public/uploads/.gitkeep

# === Logi ===
logs/
*.log

# === Edytor / IDE ===
# Pusta, lokalna konfiguracja VSCode – nie jest potrzebna w repozytorium
.vscode/
.idea/
*.swp

# === Windows (strefa "Mark of the Web" – metadane pobranych plików) ===
Zone.Identifier
*:Zone.Identifier
*.Zone.Identifier
Thumbs.db
desktop.ini

# === System operacyjny ===
.DS_Store
ehthumbs.db

# === Testy / pokrycie kodu ===
coverage/
.nyc_output/

# === Tymczasowe ===
tmp/
temp/
*.tmp
